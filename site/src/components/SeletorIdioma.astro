---
export interface OpcaoIdioma {
  nome: string;
  lang: string;
  href: string;
  atual: boolean;
  estado: 'original' | 'ia' | 'revisada' | 'falta';
}

interface Props {
  opcoes: OpcaoIdioma[];
  rotulo: string;
  textos: { original: string; ia: string; revisada: string; falta: string; ajuda: string };
  ajudaHref: string;
}

const { opcoes, rotulo, textos, ajudaHref } = Astro.props;
const atual = opcoes.find((o) => o.atual) ?? opcoes[0];
const id = `idiomas-${Math.random().toString(36).slice(2, 8)}`;
---
<prumo-idioma>
  <button type="button" class="p-botao gatilho" aria-expanded="false" aria-controls={id}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path></svg>
    <span lang={atual.lang}>{atual.nome}</span>
    <span class="p-oculto">{rotulo}</span>
    <svg class="seta" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
  </button>
  <div id={id} class="p-ilha painel" role="dialog" aria-label={rotulo} hidden>
    <p class="titulo">{rotulo}</p>
    <ul>
      {opcoes.map((o) => (
        <li>
          {o.estado === 'falta' ? (
            <div class="opcao indisponivel" lang={o.lang} aria-disabled="true">
              <span class="nome">{o.nome}</span>
              <span class="estado">{textos.falta}</span>
              <a href={ajudaHref}>{textos.ajuda}</a>
            </div>
          ) : (
            <a class="opcao" href={o.href} lang={o.lang} hreflang={o.lang} aria-current={o.atual ? 'true' : undefined}>
              <span class="texto"><span class="nome">{o.nome}</span><span class="estado">{textos[o.estado]}</span></span>
              <span class:list={['marca', { ativa: o.atual }]} aria-hidden="true"></span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</prumo-idioma>

<script>
  class PrumoIdioma extends HTMLElement {
    connectedCallback() {
      const gatilho = this.querySelector<HTMLButtonElement>('.gatilho');
      const painel = this.querySelector<HTMLElement>('.painel');
      if (!gatilho || !painel) return;
      const abrir = (sim: boolean) => {
        painel.hidden = !sim;
        gatilho.setAttribute('aria-expanded', String(sim));
        painel.classList.remove('inicio', 'acima');
        if (sim) {
          const caixa = painel.getBoundingClientRect();
          if (caixa.left < 8) painel.classList.add('inicio');
          if (caixa.bottom > innerHeight - 8) painel.classList.add('acima');
        }
        if (sim) painel.querySelector<HTMLElement>('a, [tabindex]')?.focus();
      };
      gatilho.addEventListener('click', () => abrir(painel.hidden));
      document.addEventListener('click', (evento) => {
        if (!painel.hidden && !this.contains(evento.target as Node)) abrir(false);
      });
      this.addEventListener('keydown', (evento) => {
        if (evento.key === 'Escape' && !painel.hidden) {
          abrir(false);
          gatilho.focus();
        }
      });
    }
  }
  if (!customElements.get('prumo-idioma')) customElements.define('prumo-idioma', PrumoIdioma);
</script>

<style>
  prumo-idioma {
    position: relative;
    display: inline-flex;
  }
  .gatilho {
    font-weight: 500;
    font-size: 14px;
    padding: 0 12px;
  }
  .gatilho[aria-expanded='true'] {
    background: var(--p-soft);
  }
  .seta {
    transition: transform var(--p-pop);
  }
  .gatilho[aria-expanded='true'] .seta {
    transform: rotate(180deg);
  }
  .painel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: 300px;
    padding: 8px;
    z-index: 40;
    background-color: var(--p-solid);
    transform-origin: top right;
    animation: p-pop var(--p-pop) var(--p-curva) both;
    font-family: var(--p-texto);
  }
  .painel.inicio {
    right: auto;
    left: 0;
    transform-origin: top left;
  }
  .painel.acima {
    top: auto;
    bottom: calc(100% + 10px);
    transform-origin: bottom right;
  }
  .painel {
    max-width: calc(100vw - 32px);
  }
  .titulo {
    margin: 0 0 6px;
    padding: 4px 8px 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--p-muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .opcao {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 10px;
    color: var(--p-ink);
    text-decoration: none;
  }
  a.opcao:hover,
  a.opcao[aria-current] {
    background: var(--p-soft);
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nome {
    font-weight: 600;
    font-size: 15px;
  }
  .estado {
    font-size: 12px;
    color: var(--p-muted);
  }
  .marca {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--p-todo);
    flex: 0 0 auto;
  }
  .marca.ativa {
    background: var(--p-ink);
    border-color: var(--p-ink);
  }
  .indisponivel {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    border: 1px dashed var(--p-line);
  }
  .indisponivel .nome {
    color: var(--p-muted);
  }
  .indisponivel a {
    font-size: 13px;
    font-weight: 600;
    color: var(--p-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .painel {
      animation: none;
    }
    .seta {
      transition: none;
    }
  }
</style>
