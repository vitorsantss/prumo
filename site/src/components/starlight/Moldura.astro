---
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';

const { hasSidebar } = Astro.locals.starlightRoute;
---
<div class="pagina">
  <header class="topo"><slot name="header" /></header>
  <div class="corpo">
    {hasSidebar && (
      <nav class="lateral print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <MobileMenuToggle />
        <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content p-ilha"><slot name="sidebar" /></div>
        </sl-sidebar-pane>
      </nav>
    )}
    <div class="main-frame"><slot /></div>
  </div>
</div>

<script>
  class PainelLateral extends HTMLElement {
    constructor() {
      super();
      const desktop = matchMedia('(min-width: 50em)');
      const ajustar = () => {
        this.popover = desktop.matches ? null : 'auto';
      };
      ajustar();
      desktop.addEventListener('change', ajustar);
      this.addEventListener('toggle', (evento) => {
        const aberto = (evento as ToggleEvent).newState === 'open';
        document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((el) => el.toggleAttribute('inert', aberto));
      });
    }
  }
  if (!customElements.get('sl-sidebar-pane')) customElements.define('sl-sidebar-pane', PainelLateral);
</script>

<style>
  .topo {
    position: sticky;
    top: 12px;
    z-index: var(--sl-z-index-navbar);
    max-width: 1400px;
    margin: 12px auto 0;
    padding: 0 16px;
    height: var(--sl-nav-height);
    box-sizing: border-box;
  }
  .topo::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: 100vw;
    height: 12px;
    transform: translateX(-50%);
    background: var(--p-bg);
  }
  .topo :global(.cabecalho) {
    background-color: var(--p-solid);
  }
  .corpo {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px 16px 64px;
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .main-frame {
    flex: 1 1 auto;
    min-width: 0;
  }
  .sidebar-pane {
    border: unset;
    padding: 12px;
    height: unset;
    color: unset;
    position: fixed;
    z-index: var(--sl-z-index-menu);
    inset: calc(var(--sl-nav-height) + 24px) 0 0;
    width: 100%;
    background: var(--p-bg);
    overflow-y: auto;
    box-sizing: border-box;
  }
  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 16px 8px;
  }
  @media (min-width: 50rem) {
    .lateral {
      flex: 0 0 260px;
      position: sticky;
      top: calc(var(--sl-nav-height) + 32px);
      max-height: calc(100vh - var(--sl-nav-height) - 52px);
      overflow-y: auto;
      scrollbar-width: thin;
    }
    .sidebar-pane {
      display: block;
      position: static;
      padding: 0;
      background: transparent;
      overflow: visible;
    }
  }
  @media (max-width: 50rem) {
    .topo :global(.cabecalho) {
      padding-inline-end: calc(var(--sl-menu-button-size) + 20px);
    }
    .lateral :global(.sl-menu-button) {
      top: calc(12px + (var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
      inset-inline-end: 26px;
      border: 1px solid var(--p-line);
      border-radius: 10px;
      background: var(--p-solid);
      color: var(--p-ink);
      box-shadow: none;
    }
    .corpo {
      padding-inline: 12px;
      gap: 0;
    }
  }
</style>
