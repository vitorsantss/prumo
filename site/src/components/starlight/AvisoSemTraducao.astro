---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<aside class="aviso" aria-label="Translation">
  <p>This page is not translated yet, so it is shown in Portuguese. <a href={`${base}docs/traduzir/`}>Why, and how to help</a></p>
</aside>

<style>
  .aviso {
    margin: 0 0 1.5rem;
    padding: 12px 14px;
    border: 1px dashed var(--p-line);
    border-radius: 12px;
    color: var(--p-muted);
    font-size: 14px;
  }
  .aviso p {
    margin: 0;
  }
  .aviso a {
    color: var(--p-ink);
    font-weight: 600;
  }
</style>
