---
interface Props {
  idioma: 'pt' | 'en';
  compacto?: boolean;
}

const { idioma, compacto = false } = Astro.props;
const en = idioma === 'en';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefixo = `${base}${en ? 'en/' : ''}docs/`;
const t = en
  ? { abrir: 'Search the docs', dica: 'Search pages, decisions, hypotheses…', fechar: 'Close', comece: 'Start here', paginas: 'Pages', secoes: 'Sections', nada: 'Nothing found. Try another word.', navegar: 'navigate', abrirItem: 'open', rodape: 'on-site search, no external service', carregando: 'Searching…' }
  : { abrir: 'Buscar na documentação', dica: 'Buscar páginas, decisões, hipóteses…', fechar: 'Fechar', comece: 'Comece por aqui', paginas: 'Páginas', secoes: 'Seções', nada: 'Nada encontrado. Tente outra palavra.', navegar: 'navegar', abrirItem: 'abrir', rodape: 'busca no próprio site, sem serviço externo', carregando: 'Buscando…' };
const sugestoes = en
  ? [['Start here', 'Three steps before the code.', 'comece-aqui'], ['The idea', 'Why gated stages.', 'a-ideia'], ['Current state', 'What exists and the hypotheses.', 'estado-atual'], ['Ways to contribute', 'Study, translate, write, design or code.', 'formas-de-contribuir']]
  : [['Comece aqui', 'Três passos antes do código.', 'comece-aqui'], ['A ideia', 'Por que etapas com portões.', 'a-ideia'], ['Estado atual', 'O que existe e as hipóteses.', 'estado-atual'], ['Formas de contribuir', 'Estudar, traduzir, escrever, desenhar ou programar.', 'formas-de-contribuir']];
---
<prumo-busca data-base={base} data-textos={JSON.stringify(t)}>
  <button type="button" class:list={['abrir', { compacto }]} aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
    <span class="rotulo">{t.abrir}</span>
    <kbd class="p-kbd atalho">Ctrl K</kbd>
  </button>
  <dialog class="p-ilha janela" aria-label={t.abrir}>
    <div class="campo">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
      <label class="p-oculto" for="prumo-busca-campo">{t.abrir}</label>
      <input id="prumo-busca-campo" type="search" autocomplete="off" placeholder={t.dica} role="combobox" aria-expanded="true" aria-controls="prumo-busca-lista" aria-autocomplete="list" />
      <button type="button" class="p-kbd fechar">Esc</button>
    </div>
    <div id="prumo-busca-lista" class="lista" role="listbox" aria-label={t.paginas}>
      <div class="grupo inicial">
        <span class="nome-grupo">{t.comece}</span>
        {sugestoes.map(([titulo, trecho, rota]) => (
          <a class="item" role="option" href={`${prefixo}${rota}/`}>
            <span class="icone" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h10l4 4v12H5zM9 12h6M9 16h4"></path></svg></span>
            <span class="texto"><span class="titulo">{titulo}</span><span class="trecho">{trecho}</span></span>
          </a>
        ))}
      </div>
      <div class="grupo resultados" hidden></div>
      <p class="aviso" hidden></p>
    </div>
    <div class="rodape">
      <span><kbd class="p-kbd">↑</kbd> <kbd class="p-kbd">↓</kbd> {t.navegar}</span>
      <span><kbd class="p-kbd">Enter</kbd> {t.abrirItem}</span>
      <span class="fonte">{t.rodape}</span>
    </div>
  </dialog>
</prumo-busca>

<script>
  interface SubResultado { title: string; url: string; excerpt: string }
  interface Dados { url: string; excerpt: string; meta: { title?: string }; sub_results?: SubResultado[] }
  interface Pagefind {
    options(o: Record<string, unknown>): Promise<void>;
    debouncedSearch(q: string, o?: unknown, ms?: number): Promise<{ results: { data(): Promise<Dados> }[] } | null>;
  }

  const iconePagina = 'M5 4h10l4 4v12H5zM9 12h6M9 16h4';
  const iconeSecao = 'M4 7h16M4 12h10M4 17h7';

  class PrumoBusca extends HTMLElement {
    private pagefind?: Promise<Pagefind>;
    private ativo = 0;

    connectedCallback() {
      const dialogo = this.querySelector('dialog')!;
      const campo = this.querySelector('input')!;
      const textos = JSON.parse(this.dataset.textos ?? '{}');
      const inicial = this.querySelector<HTMLElement>('.inicial')!;
      const resultados = this.querySelector<HTMLElement>('.resultados')!;
      const aviso = this.querySelector<HTMLElement>('.aviso')!;

      const itens = () => [...this.querySelectorAll<HTMLAnchorElement>('.lista .grupo:not([hidden]) .item')];
      const marcar = (indice: number) => {
        const lista = itens();
        this.ativo = Math.max(0, Math.min(indice, lista.length - 1));
        lista.forEach((item, i) => item.setAttribute('aria-selected', String(i === this.ativo)));
        lista[this.ativo]?.scrollIntoView({ block: 'nearest' });
      };

      const abrir = () => {
        dialogo.showModal();
        campo.select();
        marcar(0);
      };
      const fechar = () => dialogo.close();

      this.querySelector('.abrir')?.addEventListener('click', abrir);
      this.querySelector('.fechar')?.addEventListener('click', fechar);
      dialogo.addEventListener('click', (evento) => {
        if (evento.target === dialogo) fechar();
      });
      window.addEventListener('keydown', (evento) => {
        if ((evento.ctrlKey || evento.metaKey) && evento.key.toLowerCase() === 'k') {
          evento.preventDefault();
          if (dialogo.open) fechar();
          else abrir();
        }
      });

      campo.addEventListener('keydown', (evento) => {
        if (evento.key === 'ArrowDown') { evento.preventDefault(); marcar(this.ativo + 1); }
        if (evento.key === 'ArrowUp') { evento.preventDefault(); marcar(this.ativo - 1); }
        if (evento.key === 'Enter') { evento.preventDefault(); itens()[this.ativo]?.click(); }
      });

      const criarItem = (titulo: string, trecho: string, url: string, icone: string) => {
        const item = document.createElement('a');
        item.className = 'item';
        item.setAttribute('role', 'option');
        item.href = url;
        item.innerHTML = `<span class="icone" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="${icone}"></path></svg></span><span class="texto"><span class="titulo"></span><span class="trecho"></span></span>`;
        item.querySelector('.titulo')!.textContent = titulo;
        item.querySelector('.trecho')!.innerHTML = trecho;
        return item;
      };

      const grupo = (nome: string, filhos: HTMLElement[]) => {
        const caixa = document.createElement('div');
        caixa.className = 'subgrupo';
        const rotulo = document.createElement('span');
        rotulo.className = 'nome-grupo';
        rotulo.textContent = nome;
        caixa.append(rotulo, ...filhos);
        return caixa;
      };

      campo.addEventListener('input', async () => {
        const termo = campo.value.trim();
        inicial.hidden = termo.length > 0;
        resultados.hidden = termo.length === 0;
        aviso.hidden = true;
        if (!termo) { marcar(0); return; }
        aviso.textContent = textos.carregando;
        aviso.hidden = false;
        const busca = await (await this.carregar()).debouncedSearch(termo, {}, 200);
        if (!busca || campo.value.trim() !== termo) return;
        const dados = await Promise.all(busca.results.slice(0, 6).map((r) => r.data()));
        const paginas = dados.map((d) => criarItem(d.meta.title ?? d.url, d.excerpt, d.url, iconePagina));
        const secoes = dados
          .flatMap((d) => (d.sub_results ?? []).filter((s) => s.url !== d.url).slice(0, 1))
          .slice(0, 4)
          .map((s) => criarItem(s.title, s.excerpt, s.url, iconeSecao));
        resultados.replaceChildren(
          ...(paginas.length ? [grupo(textos.paginas, paginas)] : []),
          ...(secoes.length ? [grupo(textos.secoes, secoes)] : []),
        );
        aviso.textContent = textos.nada;
        aviso.hidden = paginas.length > 0;
        marcar(0);
      });
    }

    private carregar(): Promise<Pagefind> {
      const base = this.dataset.base ?? '/';
      this.pagefind ??= import(/* @vite-ignore */ `${base}pagefind/pagefind.js`).then(async (modulo: Pagefind) => {
        await modulo.options({ baseUrl: base });
        return modulo;
      });
      return this.pagefind;
    }
  }

  if (!customElements.get('prumo-busca')) customElements.define('prumo-busca', PrumoBusca);
</script>

<style>
  [hidden] {
    display: none !important;
  }
  prumo-busca {
    display: flex;
    flex: 1 1 260px;
    max-width: 440px;
  }
  .abrir {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 8px 0 12px;
    border: 1px solid var(--p-line);
    border-radius: 12px;
    background: var(--p-solid);
    color: var(--p-muted);
    font: 400 15px var(--p-texto);
    cursor: pointer;
  }
  .abrir .rotulo {
    flex: 1;
    text-align: left;
  }
  .abrir.compacto .rotulo,
  .abrir.compacto .atalho {
    display: none;
  }
  @media (max-width: 720px) {
    .abrir .atalho {
      display: none;
    }
  }
  .janela {
    width: min(640px, calc(100vw - 32px));
    margin: 12vh auto auto;
    padding: 0;
    color: var(--p-ink);
    background-color: var(--p-solid);
    box-shadow: var(--p-sombra-alta);
    overflow: hidden;
    font-family: var(--p-texto);
  }
  .janela[open] {
    animation: p-pop var(--p-pop) var(--p-curva) both;
  }
  .janela::backdrop {
    background: var(--p-overlay);
    backdrop-filter: blur(3px);
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    border-bottom: 1px solid var(--p-line);
    color: var(--p-muted);
  }
  .campo input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: var(--p-ink);
    font: 400 17px var(--p-texto);
    padding: 14px 0;
    outline: none;
  }
  .fechar {
    background: transparent;
    cursor: pointer;
    min-height: 28px;
  }
  .lista {
    max-height: 400px;
    overflow-y: auto;
    padding: 8px;
  }
  .grupo,
  .lista :global(.subgrupo) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 8px;
  }
  .nome-grupo,
  .lista :global(.nome-grupo) {
    padding: 8px 10px 4px;
    font-size: 12px;
    font-weight: 600;
    color: var(--p-muted);
  }
  .item,
  .lista :global(.item) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 10px;
    color: var(--p-ink);
    text-decoration: none;
  }
  .item[aria-selected='true'],
  .item:hover,
  .lista :global(.item[aria-selected='true']),
  .lista :global(.item:hover) {
    background: var(--p-soft);
  }
  .icone,
  .lista :global(.icone) {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid var(--p-line);
    color: var(--p-muted);
  }
  .texto,
  .lista :global(.texto) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .titulo,
  .lista :global(.titulo) {
    font-weight: 600;
    font-size: 15px;
  }
  .trecho,
  .lista :global(.trecho) {
    font-size: 13px;
    color: var(--p-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lista :global(mark) {
    background: transparent;
    color: var(--p-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .aviso {
    margin: 0;
    padding: 28px 12px;
    text-align: center;
    font-size: 14px;
    color: var(--p-muted);
  }
  .rodape {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--p-line);
    font-size: 12px;
    color: var(--p-muted);
  }
  .fonte {
    margin-left: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .janela[open] {
      animation: none;
    }
  }
</style>
